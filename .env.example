# ===== MiniMax API 配置 =====
# 在你的 MiniMax 开放平台 https://www.minimax.io/ 拿到 API Key 与 GroupId
# 文本模型用 MiniMax-M3（OpenAI 兼容接口），出图用 image-01

# 必填：API Key
MINIMAX_API_KEY=your_minimax_api_key_here

# 选填：GroupId（部分账号 image_generation 接口需要）
MINIMAX_GROUP_ID=

# 文本模型（默认 MiniMax-M3）
MINIMAX_TEXT_MODEL=MiniMax-M3

# OpenAI 兼容的 chat 接口基础地址（一般无需改动）
MINIMAX_CHAT_BASE=https://api.minimax.io/v1

# 出图接口基础地址（一般无需改动）
MINIMAX_IMAGE_BASE=https://api.minimax.io/v1

# 服务端口
PORT=3000
